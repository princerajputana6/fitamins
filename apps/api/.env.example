# Copy to .env and adjust.
PORT=4000
# Leave MONGODB_URI empty to run the API in in-memory mode (no DB required for local dev).
MONGODB_URI=mongodb://127.0.0.1:27017/fitamins
# Comma-separated list of allowed origins for CORS.
CORS_ORIGIN=http://localhost:5173

# --- Resend (consultation form email notifications) ---
# Get an API key at https://resend.com/api-keys . If unset, the API still saves
# leads but skips the email.
RESEND_API_KEY=
# The "from" address. Must be a Resend-verified domain, e.g. leads@fitamins.in .
# Until you verify a domain you can test with: Fitamins Website <onboarding@resend.dev>
RESEND_FROM=Fitamins Website <onboarding@resend.dev>
# Where consultation leads are delivered (comma-separated for multiple).
RESEND_TO=connect@biztreck.world
