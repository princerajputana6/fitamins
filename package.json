{
  "name": "fitamins",
  "version": "1.0.0",
  "private": true,
  "description": "Fitamins Healthcare — animated marketing site (React + Vite + Framer Motion).",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @fitamins/web",
    "build": "npm run build --workspace @fitamins/web",
    "preview": "npm run preview --workspace @fitamins/web",
    "start": "npm run start --workspace @fitamins/web",
    "lint": "npm run lint --workspace @fitamins/web",
    "clean": "npm run clean --workspace @fitamins/web && rm -rf node_modules"
  },
  "engines": {
    "node": ">=18"
  }
}
