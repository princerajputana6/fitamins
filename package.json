{
  "name": "fitamins",
  "version": "1.0.0",
  "private": true,
  "description": "Fitamins Healthcare — MERN Turborepo. Animated marketing site (React + Framer Motion) with an Express + MongoDB leads API.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "start": "turbo run start",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.1.3"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
